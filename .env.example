# Weedout configuration — LOCAL DEVELOPMENT.
#
#   cp .env.example .env
#
# ⚠ This file is for local development and every value in it is unsafe for a
# public deployment. Do not copy it to a server. Production has its own
# template — see `.env.prod.example` and DEPLOY.md.
#
# The app enforces this rather than trusting the instruction: with
# ENVIRONMENT=production it refuses to start on a placeholder SECRET_KEY, with
# DEBUG=true, or with a non-https BASE_URL. See `_check_production_hardening`
# in app/config.py.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Core -------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
# Used in alert-email links and the dashboard URLs the CLI prints, so it must
# match the origin the app is actually reached on. The local default is active here so
# `cp .env.example .env` works untouched; in production this must be the real
# https:// origin (https://weedout.dev) or the app refuses to boot.
BASE_URL=http://localhost:80
LOG_LEVEL=INFO
LOG_FORMAT=console

# REQUIRED. Minimum 32 characters. Reserved signing key — nothing signs with it
# today, but it is validated as a real secret and every deployment expects it.
# This exact value is rejected in production — it is a known placeholder.
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# ---- Database ---------------------------------------------------------------
# Matches the docker-compose service. Note the +psycopg driver suffix.
# POSTGRES_PORT is the *host* port docker-compose publishes; change it if 5432
# is already in use, and keep DATABASE_URL's port in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://weedout:weedout@localhost:5432/weedout
DB_ECHO=false

# ---- Sessions ---------------------------------------------------------------
SESSION_TTL_HOURS=336
# Session cookies are always HttpOnly and SameSite=lax. `Secure` is derived
# from ENVIRONMENT (on everywhere except local) — override only to debug, and
# never in production, where setting it false is refused at startup.
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_SAMESITE=lax

# ---- Client identity behind a proxy ------------------------------------------
# Which header carries the real client IP. Load-bearing for rate limiting:
# behind a proxy every request arrives from the proxy's address, so without
# this the IP limits become one shared bucket and the first attacker locks out
# everybody. Cloudflare sets and overwrites CF-Connecting-IP at the edge.
#
# Set it to match your deployment. If the app is NOT behind the proxy named
# here, anyone can spoof the header and rate limiting stops working — so leave
# it unset for a direct bind.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# ---- Rate limiting ------------------------------------------------------------
# Failed sign-ins tolerated per IP and per account within the window. Only
# failures count, so a legitimate user is never throttled by their own logins.
# Set any limit to 0 to disable that check.
LOGIN_RATE_LIMIT_PER_IP=15
LOGIN_RATE_LIMIT_PER_ACCOUNT=8
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
# Accounts creatable from one IP per hour; every attempt counts.
SIGNUP_RATE_LIMIT_PER_IP=5
# Reset requests per IP per hour, on top of the per-account cap below.
PASSWORD_RESET_RATE_LIMIT_PER_IP=10

# ---- Password reset ----------------------------------------------------------
# How long an emailed reset link stays valid, and how many can be requested per
# account per hour. The cap is what stops the endpoint being used to flood a
# known address with mail.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_PER_HOUR=5

# ---- Background jobs --------------------------------------------------------
# Set false when running a dedicated worker container (see docker-compose).
RUN_SCHEDULER_IN_WEB=true
KEV_REFRESH_HOURS=6
SCAN_TICK_MINUTES=15
JOB_MAX_TARGETS_PER_TICK=200

# ---- Advisory mirror --------------------------------------------------------
# The worker pulls OSV's bulk exports into the local database so that a scan
# makes no outbound HTTP calls at all. Seed a fresh deployment with:
#
#     python -m app.jobs.runner sync-mirror
#
# It is not pulled on worker boot — several hundred megabytes on every restart
# would make deploys slow.
MIRROR_REFRESH_HOURS=12
# Past this age, scans still run but every result carries a staleness warning.
# Silently serving old advisory data is how a scanner stops being trustworthy
# without anyone noticing.
MIRROR_STALE_AFTER_HOURS=48
MIRROR_TIMEOUT_SECONDS=300
MIRROR_MAX_BYTES=536870912

# ---- Scan API ---------------------------------------------------------------
# POST /api/v1/scan — used by `weedout-cli` and the GitHub Action.
API_SCAN_MAX_BYTES=5242880
# Per project, not per account, so a busy monorepo cannot lock out the other
# projects on the same plan. Well above what a normal pipeline needs, and low
# enough that a misconfigured loop cannot run away.
API_SCAN_RATE_LIMIT_PER_HOUR=60

# ---- Email ------------------------------------------------------------------
# console = log the message instead of sending it (the safe local default).
EMAIL_BACKEND=console
EMAIL_FROM=Weedout <alerts@weedout.dev>

# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# EMAIL_BACKEND=resend
# RESEND_API_KEY=re_...

# ---- Legacy Dodo records ----------------------------------------------------
# Enable only while historical subscription webhooks are still required.
DODO_ENABLED=false
# DODO_WEBHOOK_SECRET=whsec_...    # Standard Webhooks signing secret
# DODO_DASHBOARD_URL=https://app.dodopayments.com

# ---- Administration ---------------------------------------------------------
# The single super-admin. This account is promoted automatically the first time
# it signs in, so there is no admin password anywhere and no "become admin" page.
# The address must sign up normally first — this promotes an existing account.
#
# Leave unset and appoint one from a shell instead:
#   python -m app.manage promote-admin founder@weedout.dev
#   python -m app.manage list-admins
# ADMIN_EMAIL=founder@weedout.dev

# Bootstrap: if no admin exists, create one for ADMIN_EMAIL and email the
# generated password once to this address. Off unless set, and refuses to run
# with EMAIL_BACKEND=console (which would log the password). Locally, prefer
# `python -m app.manage promote-admin <email>`.
# ADMIN_BOOTSTRAP_NOTIFY_EMAIL=you@example.com

# Where the admin billing page links out to for refunds and disputes.
