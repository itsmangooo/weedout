# Weedout configuration.
#
# Copy to `.env` for local development:   cp .env.example .env
# In production, set these as real environment variables. Never commit `.env`.
#
# Generate a secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Core -------------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true
# Used in alert-email links and the OAuth redirect, so it must match the origin
# the app is actually reached on. The local default is active here so
# `cp .env.example .env` works untouched; in production use the real one:
#   BASE_URL=https://weedout.dev
BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
LOG_FORMAT=console

# REQUIRED. Minimum 32 characters. Signs the OAuth state cookie.
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# ---- Database ---------------------------------------------------------------
# Matches the docker-compose service. Note the +psycopg driver suffix.
# POSTGRES_PORT is the *host* port docker-compose publishes; change it if 5432
# is already in use, and keep DATABASE_URL's port in sync.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://weedout:weedout@localhost:5432/weedout
DB_ECHO=false

# ---- Sessions ---------------------------------------------------------------
SESSION_TTL_HOURS=336

# ---- Password reset ----------------------------------------------------------
# How long an emailed reset link stays valid, and how many can be requested per
# account per hour. The cap is what stops the endpoint being used to flood a
# known address with mail.
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_MAX_PER_HOUR=5
# Leave unset to derive from ENVIRONMENT (secure everywhere except local).
# SESSION_COOKIE_SECURE=true

# ---- Background jobs --------------------------------------------------------
# Set false when running a dedicated worker container (see docker-compose).
RUN_SCHEDULER_IN_WEB=true
KEV_REFRESH_HOURS=6
SCAN_TICK_MINUTES=15
JOB_MAX_TARGETS_PER_TICK=200

# ---- Advisory mirror --------------------------------------------------------
# The worker pulls OSV's bulk exports into the local database so that a scan
# makes no outbound HTTP calls at all. Seed a fresh deployment with:
#
#     python -m app.jobs.runner sync-mirror
#
# It is not pulled on worker boot — several hundred megabytes on every restart
# would make deploys slow.
MIRROR_REFRESH_HOURS=12
# Past this age, scans still run but every result carries a staleness warning.
# Silently serving old advisory data is how a scanner stops being trustworthy
# without anyone noticing.
MIRROR_STALE_AFTER_HOURS=48
MIRROR_TIMEOUT_SECONDS=300
MIRROR_MAX_BYTES=536870912

# ---- Scan API ---------------------------------------------------------------
# POST /api/v1/scan — used by `weedout-cli` and the GitHub Action.
API_SCAN_MAX_BYTES=5242880
# Per project, not per account, so a busy monorepo cannot lock out the other
# projects on the same plan. Well above what a normal pipeline needs, and low
# enough that a misconfigured loop cannot run away.
API_SCAN_RATE_LIMIT_PER_HOUR=60

# ---- Email ------------------------------------------------------------------
# console = log the message instead of sending it (the safe local default).
EMAIL_BACKEND=console
EMAIL_FROM=Weedout <alerts@weedout.dev>

# EMAIL_BACKEND=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false

# EMAIL_BACKEND=resend
# RESEND_API_KEY=re_...

# ---- Dodo Payments ----------------------------------------------------------
# When true, all three values below are required or the app refuses to start —
# a half-configured billing integration looks fine until money is involved.
DODO_ENABLED=false
# `test` and `live` are separate checkout hosts, not a mode flag.
DODO_ENVIRONMENT=test
# DODO_API_KEY=...                 # server-side only, never rendered
# DODO_WEBHOOK_SECRET=whsec_...    # Standard Webhooks signing secret
# DODO_PRODUCT_ID_PRO_MONTHLY=pdt_...
# DODO_DASHBOARD_URL=https://app.dodopayments.com

# ---- GitHub OAuth (optional; enables "Sign in with GitHub") -----------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Administration ---------------------------------------------------------
# The single super-admin. This account is promoted automatically the first time
# it signs in, so there is no admin password anywhere and no "become admin" page.
# The address must sign up normally first — this promotes an existing account.
#
# Leave unset and appoint one from a shell instead:
#   python -m app.manage promote-admin founder@weedout.dev
#   python -m app.manage list-admins
# ADMIN_EMAIL=founder@weedout.dev

# Where the admin billing page links out to for refunds and disputes.
