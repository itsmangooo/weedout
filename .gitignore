# Secrets — never commit. Use .env.example as the template.
.env
.env.*
!.env.example

# `weedout init` writes an API key here. The CLI warns about this, but the
# warning is easy to miss and the mistake is not recoverable by rotating a
# file — only by revoking the key.
.weedout

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
