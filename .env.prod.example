# Weedout — PRODUCTION configuration TEMPLATE.
#
#   cp .env.prod.example .env.prod
#   # fill in every value marked REQUIRED, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# ⚠ THIS FILE IS COMMITTED TO GIT. It must only ever contain empty values and
# placeholders. Real keys go in `.env.prod`, which is gitignored. If you find
# yourself pasting a live credential in here, it belongs one file over.
#
# Two independent things check this configuration, and both fail loudly:
#
#   * docker-compose.prod.yml uses `${VAR:?message}` for anything with no safe
#     default, so compose refuses to start when one is missing.
#   * The app re-validates at boot (`_check_production_hardening` in
#     app/config.py) and refuses to serve with DEBUG on, a placeholder secret
#     key, a non-https BASE_URL, or insecure cookies.
#
# ENVIRONMENT, DEBUG and LOG_FORMAT are set by docker-compose.prod.yml itself
# and are deliberately not listed here — they are not yours to get wrong.

# ---- REQUIRED ---------------------------------------------------------------

# The public origin. Must be https:// and must not be localhost.
# Used in password-reset links and alert emails, so a wrong value produces
# links that go nowhere.
BASE_URL=https://weedout.dev

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything resembling a placeholder ("change-me", "local-dev", "example", …) or
# carrying too little entropy is rejected at startup.
SECRET_KEY=

# The Postgres password. Generate it the same way — it is a real credential,
# not a label, even though the database is only reachable on the compose
# network.
POSTGRES_PASSWORD=

# ---- Strongly recommended ----------------------------------------------------

# Which header carries the real client IP. Behind Cloudflare Tunnel this must
# be cf-connecting-ip, or every visitor shares one rate-limit bucket and the
# first brute-force attempt locks out the whole site.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# The single super-admin, promoted automatically on first sign-in. The address
# has to sign up normally first. Leave unset and use
# `python -m app.manage promote-admin <email>` instead if you prefer.
ADMIN_EMAIL=

# ---- First administrator (bootstrap) -----------------------------------------
# On a fresh deployment nobody has an account, and there is no "become admin"
# page by design. If no admin exists, the app creates one for ADMIN_EMAIL with a
# generated password and emails the plaintext ONCE to the address below.
#
# Deliberately not ADMIN_EMAIL itself: at the moment the account is created
# nobody can sign in to read mail sent to it, and a typo in ADMIN_EMAIL would
# deliver the credential to whoever owns the typo. This is your own mailbox.
#
# Leave empty to disable bootstrap entirely (use
# `python -m app.manage promote-admin <email>` instead). Requires a real
# EMAIL_BACKEND: `console` is refused, because that backend delivers by writing
# the message body to the log.
#
# Runs once. An existing admin — or an existing account matching ADMIN_EMAIL —
# is never given a new password.
ADMIN_BOOTSTRAP_NOTIFY_EMAIL=

# ---- Email ------------------------------------------------------------------
# The stack runs its own Postfix relay (the `mail` service). The app talks to it
# over the Compose network with no TLS and no auth — that hop never leaves the
# host — and the relay handles the hop that does.
#
# Leave these alone unless you are bypassing the relay. `console` writes messages
# to the log instead of sending them, which means password-reset links silently
# go nowhere and the admin bootstrap refuses to run.
EMAIL_BACKEND=smtp
EMAIL_FROM=Weedout <alerts@weedout.dev>
SMTP_HOST=mail
SMTP_PORT=25
SMTP_USE_TLS=false

# ---- Mail relay (the `mail` service) -----------------------------------------
# REQUIRED. The domain you send from. The relay refuses to relay for any other
# sender, so it cannot become an open relay.
MAIL_SENDER_DOMAIN=weedout.dev

# Announced in HELO. Must be a FQDN — some providers reject anything else.
MAIL_HOSTNAME=mail.weedout.dev

# STRONGLY RECOMMENDED: the provider that does the last mile.
#
# Without it, Postfix delivers straight to Gmail and friends from your VPS
# address, which has no sending reputation and probably sits in a range that is
# blocklisted by default — so password resets land in spam or are rejected
# outright. Most hosts also block outbound port 25.
#
#   Resend:  [smtp.resend.com]:587
#   Mailgun: [smtp.mailgun.org]:587
#   SES:     [email-smtp.<region>.amazonaws.com]:587
#   Postmark:[smtp.postmarkapp.com]:587
#
# The square brackets are not decoration: they tell Postfix to use the host as
# given rather than looking up its MX record.
MAIL_RELAYHOST=
MAIL_RELAYHOST_USERNAME=
MAIL_RELAYHOST_PASSWORD=
# `encrypt` refuses to send credentials over an unencrypted connection.
MAIL_RELAYHOST_TLS_LEVEL=encrypt

# See DEPLOY.md for the SPF / DKIM / DMARC records your domain needs. Without
# them Gmail and Yahoo will reject or spam-folder the mail regardless of which
# provider you use.

# Or, to bypass the relay and use Resend's HTTP API directly — simpler, but you
# lose the queue-and-retry that stops a provider blip losing a password reset:
# EMAIL_BACKEND=resend
# RESEND_API_KEY=

# ---- Backups -----------------------------------------------------------------
# The worker takes a compressed pg_dump on a schedule. Local dumps live on the
# same disk as the database, so they survive a bad migration but not a dead
# host — set the S3 block below to get them off the box.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Off-box storage. Any S3-compatible endpoint; Cloudflare R2 has no egress fees.
#   R2:  https://<account-id>.r2.cloudflarestorage.com
# Leave BACKUP_S3_BUCKET empty to keep dumps local only.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=weedout
BACKUP_S3_REGION=auto

# ---- Optional ----------------------------------------------------------------

LOG_LEVEL=INFO

# Billing. When DODO_ENABLED=true all three values below are required or the
# app refuses to start — a half-configured billing integration looks fine until
# money is involved.
DODO_ENABLED=false
DODO_ENVIRONMENT=live
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_PRO_MONTHLY=
