# Weedout — PRODUCTION configuration TEMPLATE.
#
#   cp .env.prod.example .env.prod
#   # fill in every value marked REQUIRED, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# ⚠ THIS FILE IS COMMITTED TO GIT. It must only ever contain empty values and
# placeholders. Real keys go in `.env.prod`, which is gitignored. If you find
# yourself pasting a live credential in here, it belongs one file over.
#
# Two independent things check this configuration, and both fail loudly:
#
#   * docker-compose.prod.yml uses `${VAR:?message}` for anything with no safe
#     default, so compose refuses to start when one is missing.
#   * The app re-validates at boot (`_check_production_hardening` in
#     app/config.py) and refuses to serve with DEBUG on, a placeholder secret
#     key, a non-https BASE_URL, or insecure cookies.
#
# ENVIRONMENT, DEBUG and LOG_FORMAT are set by docker-compose.prod.yml itself
# and are deliberately not listed here — they are not yours to get wrong.

# ---- REQUIRED ---------------------------------------------------------------

# The public origin. Must be https:// and must not be localhost.
# Used in password-reset links and alert emails, so a wrong value produces
# links that go nowhere.
BASE_URL=https://weedout.dev

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Anything resembling a placeholder ("change-me", "local-dev", "example", …) or
# carrying too little entropy is rejected at startup.
SECRET_KEY=

# The Postgres password. Generate it the same way — it is a real credential,
# not a label, even though the database is only reachable on the compose
# network.
POSTGRES_PASSWORD=

# ---- Strongly recommended ----------------------------------------------------

# Which header carries the real client IP. Behind Cloudflare Tunnel this must
# be cf-connecting-ip, or every visitor shares one rate-limit bucket and the
# first brute-force attempt locks out the whole site.
TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# The single super-admin, promoted automatically on first sign-in. The address
# has to sign up normally first. Leave unset and use
# `python -m app.manage promote-admin <email>` instead if you prefer.
ADMIN_EMAIL=

# Email. `console` writes messages to the log instead of sending them, which
# means password-reset links silently go nowhere — the app warns loudly at
# startup if it is left that way in production.
EMAIL_BACKEND=smtp
EMAIL_FROM=Weedout <alerts@weedout.dev>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Or, instead of SMTP:
# EMAIL_BACKEND=resend
# RESEND_API_KEY=

# ---- Backups -----------------------------------------------------------------
# The worker takes a compressed pg_dump on a schedule. Local dumps live on the
# same disk as the database, so they survive a bad migration but not a dead
# host — set the S3 block below to get them off the box.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# Off-box storage. Any S3-compatible endpoint; Cloudflare R2 has no egress fees.
#   R2:  https://<account-id>.r2.cloudflarestorage.com
# Leave BACKUP_S3_BUCKET empty to keep dumps local only.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=weedout
BACKUP_S3_REGION=auto

# ---- Optional ----------------------------------------------------------------

LOG_LEVEL=INFO

# Billing. When DODO_ENABLED=true all three values below are required or the
# app refuses to start — a half-configured billing integration looks fine until
# money is involved.
DODO_ENABLED=false
DODO_ENVIRONMENT=live
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_ID_PRO_MONTHLY=
